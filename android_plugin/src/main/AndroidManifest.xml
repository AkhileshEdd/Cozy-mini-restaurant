<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Cloud save: what Android backs up to the player's Google account
         (the export preset turns backup on with user_data_backup/allow). -->
    <application
        android:dataExtractionRules="@xml/cozy_data_extraction_rules"
        android:fullBackupContent="@xml/cozy_backup_rules">
        <!-- Registers the plugin with Godot (Android plugin v2). The AdMob
             APPLICATION_ID is added by the editor export plugin from the
             cozy_services/admob/android_app_id project setting. -->
        <meta-data
            android:name="org.godotengine.plugin.v2.CozyServices"
            android:value="com.cozyminirestaurant.services.CozyServicesPlugin" />
    </application>

</manifest>
